# Vouch API key (required). Get one from the Vouch developer portal.
VOUCH_API_KEY=sk_test_your_key_here

# GitHub token (optional). Without it GitHub allows 60 requests/hour per IP,
# which is roughly 20 PR verifications. A read-only token raises it to 5000/hour.
GITHUB_TOKEN=

# Program slug on Vouch. Change for a clean slate.
SLUG=meritgrant-demo

# Port to listen on.
PORT=4319
